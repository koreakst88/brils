{
  "buildCommand": "cd ../.. && npm run build --workspace @brils/admin",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && npm install --workspaces --include-workspace-root",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
